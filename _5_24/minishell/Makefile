###############################################################################
# Makefile — minishell：简易 Shell 示例
#
# 功能：
#   - 基本命令执行（ls、cat、echo 等）
#   - 管道连接（|），如：ls | grep c | wc -l
#   - 输入重定向（<）和输出重定向（>、>>）
#
# 用法：
#   make          - 编译 minishell
#   make clean    - 删除可执行文件
#   make run      - 编译并运行（交互模式，Ctrl+D 或 Ctrl+C 退出）
#   make help     - 显示此帮助信息
###############################################################################

# ── 编译器及选项 ────────────────────────────────────────────────────────────
CC      = gcc
CFLAGS  = -Wall -Wextra -g -O2
# -Wall -Wextra : 启用大部分编译警告
# -g            : 生成调试信息（gdb 可用）
# -O2           : 二级优化

LDFLAGS =

# ── 目标可执行文件 ──────────────────────────────────────────────────────────
TARGET  = minishell

###############################################################################
# 默认目标
###############################################################################
.PHONY: all
all: $(TARGET)

###############################################################################
# 编译 + 链接
###############################################################################
$(TARGET): minishell.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

###############################################################################
# 清理
###############################################################################
.PHONY: clean
clean:
	rm -f $(TARGET)

###############################################################################
# 运行示例
#
# 启动后即可在 "minishell$ " 提示符下输入命令，例如：
#   ls -l | grep .c
#   cat < /etc/hostname
#   echo hello > /tmp/test.txt
#   cat < /tmp/test.txt | wc -c
#
# 按 Ctrl+C 或 Ctrl+D 退出。
###############################################################################
.PHONY: run
run: all
	@echo "============================================"
	@echo "  minishell — 简易 Shell（支持管道）"
	@echo "============================================"
	@echo ""
	@echo "  支持的命令："
	@echo "    基本:   ls, cat, echo, wc, grep, ..."
	@echo "    管道:   cmd1 | cmd2 | cmd3"
	@echo "    重定向: < input.txt, > output.txt, >> append.txt"
	@echo ""
	@echo "  输入 Ctrl+C 或 Ctrl+D 退出。"
	@echo "============================================"
	@echo ""
	./$(TARGET)

###############################################################################
# 帮助
###############################################################################
.PHONY: help
help:
	@echo "可用目标:"
	@echo "  make          编译 minishell"
	@echo "  make clean    删除可执行文件"
	@echo "  make run      编译并运行"
	@echo "  make help     显示此帮助"
	@echo ""
	@echo "示例命令:"
	@echo "  ls -l | grep minishell"
	@echo "  cat < /etc/hostname"
	@echo "  echo hello > /tmp/test.txt && cat /tmp/test.txt"
	@echo "  ls -l / | wc -l"
