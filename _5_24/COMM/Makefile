###############################################################################
# Makefile — 共享内存通信示例构建脚本
#
# 用法:
#   make          - 编译 server 和 client
#   make clean    - 删除生成的可执行文件和中间目标文件
#   make run      - 编译并运行示例（后台运行 server，再运行 client）
#   make ipcs     - 查看当前系统中的共享内存段（用于调试/清理残留）
#   make help     - 显示帮助信息
#
# 文件依赖关系:
#   server <-- server.o + comm.o <-- server.c + comm.c + comm.h
#   client <-- client.o + comm.o <-- client.c + comm.c + comm.h
###############################################################################

# 编译器及选项
CC       = gcc
CFLAGS   = -Wall -Wextra -g -O2
# -Wall -Wextra : 启用大部分编译警告，帮助发现潜在问题
# -g            : 生成调试信息，方便用 gdb 调试
# -O2           : 二级优化（平衡编译速度和运行效率）

# 链接器选项
LDFLAGS  =

# 目标可执行文件
TARGETS  = server client

# 目标文件（.o 文件）
OBJS     = server.o client.o comm.o

###############################################################################
# 默认目标：编译所有
###############################################################################
.PHONY: all
all: $(TARGETS)

###############################################################################
# 链接规则：将目标文件链接为可执行文件
###############################################################################
server: server.o comm.o
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

client: client.o comm.o
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

###############################################################################
# 编译规则：将 .c 源文件编译为 .o 目标文件
###############################################################################
server.o: server.c comm.h
	$(CC) $(CFLAGS) -c $< -o $@

client.o: client.c comm.h
	$(CC) $(CFLAGS) -c $< -o $@

comm.o: comm.c comm.h
	$(CC) $(CFLAGS) -c $< -o $@

###############################################################################
# 清理规则：删除所有编译产物
###############################################################################
.PHONY: clean
clean:
	rm -f $(TARGETS) $(OBJS)

###############################################################################
# 运行示例：编译 + 后台启动 server + 前台运行 client
###############################################################################
.PHONY: run
run: all
	@echo "============================================"
	@echo "  共享内存 IPC 示例"
	@echo "============================================"
	@echo ""
	@echo "[1] 后台启动 server..."
	./server &
	SERVER_PID=$$!; \
	echo "    server PID = $$SERVER_PID"; \
	sleep 1; \
	echo "[2] 前台运行 client..."; \
	./client; \
	echo ""; \
	echo "[3] 等待 server 退出..."; \
	wait $$SERVER_PID 2>/dev/null; \
	echo "    server 已退出。"; \
	echo ""; \
	echo "============================================"
	@echo "  运行结束"
	@echo "============================================"

###############################################################################
# 调试工具：查看当前系统中的共享内存段
###############################################################################
.PHONY: ipcs
ipcs:
	ipcs -m

###############################################################################
# 帮助信息
###############################################################################
.PHONY: help
help:
	@echo "可用目标:"
	@echo "  make         编译 server 和 client"
	@echo "  make clean   删除编译产物"
	@echo "  make run     编译并运行示例"
	@echo "  make ipcs    查看系统中的共享内存段"
	@echo "  make help    显示此帮助"
