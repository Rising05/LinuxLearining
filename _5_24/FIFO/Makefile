# ============================================================
# Makefile — FIFO 命名管道示例（交互式聊天版）
#
# 用法：
#   make           构建所有目标
#   make clean     删除构建产物和残留 FIFO
#   make test      编译检查（交互式程序需手动在两个终端测试）
# ============================================================

CC       = gcc
CFLAGS   = -Wall -Wextra -g -O2

# 目标可执行文件
TARGETS  = fifo_write fifo_read

# 默认目标：构建所有
.PHONY: all
all: $(TARGETS)

# -----------------------------------------------------------
# 编译规则
# -----------------------------------------------------------

fifo_write: fifo_write.c
	$(CC) $(CFLAGS) -o $@ $<

fifo_read: fifo_read.c
	$(CC) $(CFLAGS) -o $@ $<

# -----------------------------------------------------------
# 清理规则
# -----------------------------------------------------------
.PHONY: clean
clean:
	rm -f $(TARGETS) mypipe abc abc.bak

# -----------------------------------------------------------
# 编译检查（交互式程序不适合自动化测试）
# -----------------------------------------------------------
.PHONY: test
test: $(TARGETS)
	@echo "=== 编译成功 ==="
	@echo "手动测试步骤："
	@echo "  终端1: ./fifo_read"
	@echo "  终端2: ./fifo_write"
	@echo "  在终端2输入文字，终端1会显示收到的消息"
	@echo "  按 Ctrl+D 结束写端，读端自动退出"
