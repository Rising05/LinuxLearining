###############################################################################
# Makefile — SHM_FIFO：共享内存 + FIFO 同步通信示例
#
# 架构：
#   Server（读端）←── FIFO（通知通道）──→ Client（写端）
#                          ↕
#                   共享内存（数据通道）
#
# 文件依赖关系：
#   shm_server <-- ShmServer.cc + Comm.hpp
#   shm_client <-- ShmClient.cc + Comm.hpp
#
# Comm.hpp 是 header-only 头文件（所有实现都在 .hpp 内），
# 因此不需要单独的 .o 文件。两个源文件各自 #include 即可。
#
# 用法：
#   make            - 编译 shm_server 和 shm_client
#   make clean      - 删除可执行文件
#   make run        - 编译并运行（先启动 server，再启动 client）
#   make help       - 显示此帮助信息
###############################################################################

# ── 编译器及选项 ────────────────────────────────────────────────────────────
CXX      = g++
CXXFLAGS = -Wall -Wextra -g -O2 -std=c++11
# -Wall -Wextra : 启用大部分编译警告
# -g            : 生成调试信息（gdb 可用）
# -O2           : 二级优化
# -std=c++11    : 使用 C++11 标准（std::to_string 等）

LDFLAGS  =

# ── 目标可执行文件 ──────────────────────────────────────────────────────────
TARGETS  = shm_server shm_client

###############################################################################
# 默认目标
###############################################################################
.PHONY: all
all: $(TARGETS)

###############################################################################
# 链接规则
#
# 因为 Comm.hpp 是 header-only，每个 .cc 只编译自己的 .o，
# 然后直接链接成可执行文件，不需要额外的 comm.o。
###############################################################################
shm_server: ShmServer.cc Comm.hpp
	$(CXX) $(CXXFLAGS) -o $@ ShmServer.cc $(LDFLAGS)

shm_client: ShmClient.cc Comm.hpp
	$(CXX) $(CXXFLAGS) -o $@ ShmClient.cc $(LDFLAGS)

###############################################################################
# 清理规则
###############################################################################
.PHONY: clean
clean:
	rm -f $(TARGETS)
	rm -f ./fifo        # 清理可能残留的 FIFO 文件

###############################################################################
# 运行示例
#
# 启动顺序：
#   1. 后台启动 shm_server（它会阻塞等待 client 连接）
#   2. 前台运行 shm_client（用户在此输入文本）
#   3. 用户输入 quit 后两端同时退出
#
# 注意：
#   - ftok() 使用的路径 PATH_NAME="/home/hyb" 必须存在且可访问。
#     如果不存在，需要修改 Comm.hpp 中的 PATH_NAME，或创建该目录。
#   - 运行前请确保没有残留的共享内存段（可用 ipcs -m 查看，
#     用 ipcrm -m <shmid> 删除）。
###############################################################################
.PHONY: run
run: all
	@echo "============================================"
	@echo "  共享内存 + FIFO 同步通信示例"
	@echo "============================================"
	@echo ""
	@echo "  Server（读端）◄── FIFO ──► Client（写端）"
	@echo "         ▲                        │"
	@echo "         └──── 共享内存 ◄─────────┘"
	@echo ""
	@echo "  客户端输入文本，服务端打印文本。"
	@echo "  输入 quit 退出。"
	@echo ""
	@echo "[1] 启动 shm_server（后台）..."
	./shm_server &
	SERVER_PID=$$!; \
	echo "    server PID = $$SERVER_PID"; \
	sleep 0.5; \
	echo "[2] 启动 shm_client（前台）..."; \
	echo "--------------------------------------------"; \
	./shm_client; \
	echo "--------------------------------------------"; \
	echo ""; \
	echo "[3] 等待 server 退出..."; \
	wait $$SERVER_PID 2>/dev/null; \
	echo "    server 已退出。"; \
	echo ""; \
	echo "============================================"
	@echo "  运行结束"
	@echo "============================================"

###############################################################################
# 帮助信息
###############################################################################
.PHONY: help
help:
	@echo "可用目标:"
	@echo "  make           编译 shm_server 和 shm_client"
	@echo "  make clean     删除可执行文件"
	@echo "  make run       编译并运行示例"
	@echo "  make help      显示此帮助"
	@echo ""
	@echo "手动运行方式:"
	@echo "  终端1: ./shm_server"
	@echo "  终端2: ./shm_client"
	@echo ""
	@echo "注意事项:"
	@echo "  - PATH_NAME 必须是一个存在的路径（默认 /home/hyb）"
	@echo "  - 如果 make run 失败，请用 ipcs -m 检查残留共享内存"
